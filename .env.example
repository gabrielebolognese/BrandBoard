# Copy to .env and fill in.

# PostgreSQL 13+. The test suite TRUNCATEs, so it refuses any database without
# "test" in the name unless ALLOW_DESTRUCTIVE_TESTS=1.
DATABASE_URL=postgres://flashbrand:flashbrand@localhost:5433/flashbrand_test

# Polar (merchant of record). With none of these set, /pay answers 503 and says
# which ones are missing, and a featured slot is granted without charging.
#
# Two products, both with a CUSTOM price, because a planet costs the sum of its
# tiles and that is continuous rather than a tier list:
#   POLAR_SUBSCRIPTION_PRODUCT_ID  recurring, yearly
#   POLAR_FEATURED_PRODUCT_ID      one time
#
# POLAR_SERVER defaults to sandbox. Only the literal string "production" moves
# it, because only one of the two charges a real card by accident.
# POLAR_ACCESS_TOKEN=polar_oat_...
# POLAR_SUBSCRIPTION_PRODUCT_ID=
# POLAR_FEATURED_PRODUCT_ID=
# POLAR_SERVER=sandbox

# Without the webhook secret the endpoint refuses every delivery rather than
# accepting unsigned ones.
# POLAR_WEBHOOK_SECRET=whsec_...

# Salts the daily hash a click is counted against. Changing it resets the
# once-per-visitor-per-day window; leaving it unset is fine for development.
# CLICK_SALT=

# Tile rates are decided in src/config.ts, per orbit, and are not configurable
# per environment: they are a product decision, not a deployment one.
