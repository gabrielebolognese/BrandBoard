# Copy to .env and fill in.

# PostgreSQL 13+. The test suite TRUNCATEs, so it refuses any database without
# "test" in the name unless ALLOW_DESTRUCTIVE_TESTS=1.
DATABASE_URL=postgres://flashbrand:flashbrand@localhost:5433/flashbrand_test

# Flat rate per tile PER MONTH, in minor units (cents). Blocks are rented, not
# bought outright: a 1x1 costs this every month, a 3x3 costs 9x every month.
# No default on purpose: an unset price must fail loudly, never guess.
# PRICE_PER_TILE_CENTS_PER_MONTH=
